{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "users-route": {
        "ClusterId": "users-cluster",
        "Match": {
          "Path": "/users-service/{**catchall}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/users-service" }
        ]
      },
      "orders-route": {
        "ClusterId": "orders-cluster",
        "Match": {
          "Path": "/orders-service/{**catchall}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/orders-service" }
        ]
      }
    },
    "Clusters": {
      "users-cluster": {
        "Destinations": {
          "users": { "Address": "http://user-cluster-ip" }
        }
      },
      "orders-cluster": {
        "Destinations": {
          "orders": { "Address": "http://order-cluster-ip" }
        }
      }
    }
  }
}